{
  "name": "jsonata-exerciser",
  "displayName": "JSONata Exerciser",
  "description": "Local, real-time JSONata playground and debugger for VS Code: live output, IntelliSense, validation, formatter, demos, online help and Copilot / Claude integration.",
  "version": "1.0.0",
  "publisher": "ro-rtm",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/RoRtm/jsonata-exerciser.git"
  },
  "bugs": {
    "url": "https://github.com/RoRtm/jsonata-exerciser/issues"
  },
  "homepage": "https://github.com/RoRtm/jsonata-exerciser#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Debuggers",
    "Chat",
    "Other"
  ],
  "keywords": [
    "jsonata",
    "json",
    "query",
    "transform",
    "playground",
    "exerciser",
    "copilot",
    "mcp"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:jsonata"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "languages": [
      {
        "id": "jsonata",
        "aliases": [
          "JSONata",
          "jsonata"
        ],
        "extensions": [
          ".jsonata"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "jsonata",
        "scopeName": "source.jsonata",
        "path": "./syntaxes/jsonata.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "jsonata",
        "path": "./snippets/jsonata.json"
      }
    ],
    "commands": [
      {
        "command": "jsonataExerciser.open",
        "title": "Open Exerciser",
        "category": "JSONata",
        "icon": "$(play)"
      },
      {
        "command": "jsonataExerciser.openDemo",
        "title": "Open Exerciser with Demo...",
        "category": "JSONata",
        "icon": "$(beaker)"
      },
      {
        "command": "jsonataExerciser.openWithFiles",
        "title": "Open Exerciser with Existing Files...",
        "category": "JSONata"
      },
      {
        "command": "jsonataExerciser.evaluate",
        "title": "Evaluate Now",
        "category": "JSONata",
        "icon": "$(debug-start)"
      },
      {
        "command": "jsonataExerciser.format",
        "title": "Format Expression",
        "category": "JSONata"
      },
      {
        "command": "jsonataExerciser.copyResult",
        "title": "Copy Result",
        "category": "JSONata"
      },
      {
        "command": "jsonataExerciser.openHelp",
        "title": "Open Online Help...",
        "category": "JSONata",
        "icon": "$(question)"
      },
      {
        "command": "jsonataExerciser.helpAtCursor",
        "title": "Help for Function at Cursor",
        "category": "JSONata"
      },
      {
        "command": "jsonataExerciser.openTryOnline",
        "title": "Open try.jsonata.org (browser)",
        "category": "JSONata"
      },
      {
        "command": "jsonataExerciser.copyMcpConfig",
        "title": "Copy MCP Server Config (Claude Code / Claude Desktop)",
        "category": "JSONata"
      },
      {
        "command": "jsonataExerciser.applyExpression",
        "title": "Apply Expression to Exerciser",
        "category": "JSONata"
      }
    ],
    "keybindings": [
      {
        "command": "jsonataExerciser.evaluate",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "resourceLangId == jsonata || resourceFilename == input.json"
      },
      {
        "command": "jsonataExerciser.helpAtCursor",
        "key": "shift+f1",
        "when": "editorTextFocus && editorLangId == jsonata"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "jsonataExerciser.open",
          "when": "resourceLangId == jsonata",
          "group": "navigation@1"
        },
        {
          "command": "jsonataExerciser.openDemo",
          "when": "resourceLangId == jsonata",
          "group": "navigation@2"
        },
        {
          "command": "jsonataExerciser.openHelp",
          "when": "resourceLangId == jsonata",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "jsonataExerciser.applyExpression",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "JSONata Exerciser",
      "properties": {
        "jsonataExerciser.autoEvaluate": {
          "type": "boolean",
          "default": true,
          "description": "Re-evaluate the expression automatically while typing (real-time output)."
        },
        "jsonataExerciser.debounceMs": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "maximum": 5000,
          "description": "Delay in milliseconds between the last keystroke and the evaluation."
        },
        "jsonataExerciser.evaluationTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "description": "Evaluations running longer than this are aborted (protects against endless recursion)."
        },
        "jsonataExerciser.format.printWidth": {
          "type": "number",
          "default": 80,
          "minimum": 20,
          "description": "Maximum line width used by the JSONata formatter."
        },
        "jsonataExerciser.intellisense.fieldSuggestions": {
          "type": "boolean",
          "default": true,
          "description": "Suggest field names found in the Exerciser input JSON."
        },
        "jsonataExerciser.ai.registerMcpServerInVsCode": {
          "type": "boolean",
          "default": false,
          "description": "Also register the bundled MCP server with VS Code. Not needed for GitHub Copilot (it uses the built-in language model tools); useful if you want the same tools via the MCP list. Requires reload."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "jsonata-exerciser.jsonata",
        "name": "jsonata",
        "fullName": "JSONata Exerciser",
        "description": "Write, explain and fix JSONata expressions against your Exerciser input",
        "isSticky": true,
        "commands": [
          {
            "name": "write",
            "description": "Write a JSONata expression for the current input"
          },
          {
            "name": "explain",
            "description": "Explain the expression currently in the Exerciser"
          },
          {
            "name": "fix",
            "description": "Fix the error in the current expression"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "jsonata_evaluate",
        "toolReferenceName": "jsonataEvaluate",
        "displayName": "Evaluate JSONata",
        "userDescription": "Evaluate a JSONata expression against JSON input locally.",
        "modelDescription": "Evaluates a JSONata expression against a JSON document using the official jsonata library, locally. Returns the pretty-printed JSON result or the JSONata error (code, message, position). Use this to test an expression before proposing it to the user.",
        "canBeReferencedInPrompt": true,
        "icon": "$(play)",
        "tags": [
          "jsonata",
          "json"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "expression": {
              "type": "string",
              "description": "The JSONata expression."
            },
            "input": {
              "type": "string",
              "description": "The input JSON document as a JSON string. Omit to evaluate against no input."
            }
          },
          "required": [
            "expression"
          ]
        }
      },
      {
        "name": "jsonata_validate",
        "toolReferenceName": "jsonataValidate",
        "displayName": "Validate JSONata",
        "userDescription": "Check the syntax of a JSONata expression.",
        "modelDescription": "Parses a JSONata expression with the official jsonata parser and reports syntax errors and unknown $function calls with their positions. Does not evaluate.",
        "canBeReferencedInPrompt": true,
        "icon": "$(check)",
        "tags": [
          "jsonata"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "expression": {
              "type": "string",
              "description": "The JSONata expression."
            }
          },
          "required": [
            "expression"
          ]
        }
      },
      {
        "name": "jsonata_getExerciser",
        "toolReferenceName": "jsonataExerciserState",
        "displayName": "Read JSONata Exerciser",
        "userDescription": "Read the expression, input and current result from the JSONata Exerciser.",
        "modelDescription": "Returns the JSONata expression, the input JSON, the current output and any error shown in the user's JSONata Exerciser. Call this first when the user asks about 'my expression', 'the error' or 'the output'.",
        "canBeReferencedInPrompt": true,
        "icon": "$(eye)",
        "tags": [
          "jsonata"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "jsonata_updateExerciser",
        "toolReferenceName": "jsonataExerciserUpdate",
        "displayName": "Update JSONata Exerciser",
        "userDescription": "Replace the expression and/or input in the JSONata Exerciser.",
        "modelDescription": "Replaces the expression and/or the input JSON shown in the user's JSONata Exerciser and returns the new result. Only use after the user asked you to change or apply something; it overwrites what they have typed.",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "tags": [
          "jsonata"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "expression": {
              "type": "string",
              "description": "New JSONata expression (optional)."
            },
            "input": {
              "type": "string",
              "description": "New input JSON text (optional)."
            }
          }
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "jsonata-exerciser.mcp",
        "label": "JSONata Exerciser"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node esbuild.mjs && node --import tsx --test test/*.test.ts",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "npx ovsx publish"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@stedi/prettier-plugin-jsonata": "^2.1.8",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "jsonata": "^2.1.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "zod": "^3.25.0"
  }
}
